/**
 * \file
 * X-Macro definition file for dummy batchnorm layer sizes.
 *
 * Contains a number of calls to the NET_PARAMS function macro defining
 * the following batchnorm parameters, as used in the dummy network.
 *
 * The ordering of the arguments is:
 * \code
 *   NET_PARAMS(Rows, Cols, Channels)
 * \endcode
 *
 */
#ifndef NET_PARAMS
#error This file expects the NET_PARAMS macro to be defined.
#endif

NET_PARAMS(224, 224, 3)
NET_PARAMS(56, 56, 64)
NET_PARAMS(112, 112, 64)
NET_PARAMS(28, 28, 128)
NET_PARAMS(56, 56, 128)
NET_PARAMS(14, 14, 256)
NET_PARAMS(28, 28, 256)
NET_PARAMS(56, 56, 256)
NET_PARAMS(7, 7, 512)
NET_PARAMS(14, 14, 512)
NET_PARAMS(28, 28, 512)
NET_PARAMS(14, 14, 1024)
NET_PARAMS(7, 7, 2048)
