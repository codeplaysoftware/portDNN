// clang-format off
#define SNN_DATA_TYPE       @DATA_TYPE@
#define SNN_VECTOR_WIDTH    @VECTOR_WIDTH@
#define SNN_TARRAY_MAX_SIZE @TARRAY_MAX_SIZE@
// clang-format on

#include <CL/sycl.hpp>

#include "sycldnn/concat/params.h"
#include "sycldnn/concat/tarray.h"
#include "sycldnn/mem_object.h"
#include "sycldnn/status.h"

#include "sycldnn/backend/snn_backend.h"
#include "sycldnn/backend/snn_usm_backend.h"

#include "src/concat/queue_concat_impl.h"

namespace sycldnn {
namespace concat {
namespace internal {

#ifdef SNN_ENABLE_USM
template SNNStatus
queue_concat<SNN_DATA_TYPE, SNN_VECTOR_WIDTH, sycldnn::backend::SNNUSMBackend,
             SNN_TARRAY_MAX_SIZE, USMMemObject>(
    TArray<SNN_DATA_TYPE, sycldnn::backend::SNNUSMBackend, SNN_TARRAY_MAX_SIZE>&
        input_tarray,
    std::array<int, SNN_TARRAY_MAX_SIZE> chunk_sizes,
    std::array<int, SNN_TARRAY_MAX_SIZE> input_offsets,
    std::array<int, SNN_TARRAY_MAX_SIZE> flat_sizes, const int chunk_offset,
    USMMemObject<SNN_DATA_TYPE>& out_mem, cl::sycl::queue& queue,
    const std::vector<cl::sycl::event>& events);
#endif

template SNNStatus
queue_concat<SNN_DATA_TYPE, SNN_VECTOR_WIDTH, sycldnn::backend::SNNBackend,
             SNN_TARRAY_MAX_SIZE, BufferMemObject>(
    TArray<SNN_DATA_TYPE, sycldnn::backend::SNNBackend, SNN_TARRAY_MAX_SIZE>&
        input_tarray,
    std::array<int, SNN_TARRAY_MAX_SIZE> chunk_sizes,
    std::array<int, SNN_TARRAY_MAX_SIZE> input_offsets,
    std::array<int, SNN_TARRAY_MAX_SIZE> flat_sizes, const int chunk_offset,
    BufferMemObject<SNN_DATA_TYPE>& out_mem, cl::sycl::queue& queue,
    const std::vector<cl::sycl::event>& events);

}  // namespace internal
}  // namespace concat
}  // namespace sycldnn
